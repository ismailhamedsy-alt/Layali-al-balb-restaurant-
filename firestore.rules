rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Restaurant config: readable by all customers in real-time, validated on write
    match /restaurant_config/{configId} {
      allow read: if true;
      allow write: if request.resource.data.name is string &&
                      request.resource.data.whatsappNumber is string;
    }

    // Menu items & prices: readable by all customers in real-time, validated on write
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update: if request.resource.data.name is string &&
                               request.resource.data.priceTRY is number &&
                               request.resource.data.category is string;
      allow delete: if true;
    }
  }
}
